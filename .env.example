# Local model runtime
SOVARA_OLLAMA_URL=http://localhost:11434

# Reasoning model configuration
SOVARA_REASONING_MODEL=qwen3:4b
SOVARA_REASONING_TIMEOUT=120
SOVARA_REASONING_MAX_TOKENS=4096
SOVARA_REASONING_NUM_CTX=8192

# Vision model configuration
SOVARA_VLM_MODEL=qwen2.5-vl:3b
SOVARA_VLM_TIMEOUT=120
SOVARA_VLM_MAX_TOKENS=2048
SOVARA_VLM_NUM_CTX=4096

# OCR configuration
SOVARA_OCR_LANG=en
SOVARA_OCR_ADDITIONAL_LANGS=hi
SOVARA_OCR_USE_GPU=false
SOVARA_OCR_SHOW_LOG=false

# Document & Image Processing
SOVARA_IMAGE_MAX_DIM=1920
SOVARA_PDF_RENDER_DPI=200
SOVARA_MAX_FILE_SIZE=104857600
SOVARA_MAX_PAGES=200
SOVARA_TEMP_DIR=

# Sandbox & Execution Limits
SOVARA_SANDBOX_TIMEOUT=10
SOVARA_SANDBOX_MEMORY=256m
SOVARA_SANDBOX_CPU=1.0
SOVARA_DOCKER_IMAGE=python:3.11-slim
SOVARA_WORKSPACE_ROOT=.
SOVARA_MAX_FILE_READ_BYTES=1048576
